# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# payload
888.db
888.db-*
media/

# backups
backups/

# graphify: a derived code graph, rebuilt with `graphify update .` — it also
# copies README text (which once held a password) into JSON, so never commit it.
graphify-out/

888-site.zip
cpanel-env.txt

# QA output
qa-screenshots/
