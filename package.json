{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "devsafe": "rm -rf .next && next dev",
    "build": "NODE_OPTIONS=--max-old-space-size=8000 next build",
    "start": "payload migrate && next start",
    "vercel-build": "payload migrate && next build",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "seed": "payload run src/seed/index.ts",
    "test": "npx tsx src/lib/test-template.ts && npx tsx src/lib/test-media-url.ts && npx tsx src/lib/test-rate-limit.ts && npx tsx src/lib/test-enquiry-schema.ts && npx tsx src/lib/test-base-path.ts && payload run src/lib/test-email.ts",
    "email:check": "payload run src/lib/send-test-email.ts",
    "migrate": "payload migrate",
    "migrate:create": "payload migrate:create",
    "backup": "node scripts/backup.mjs",
    "versions:backfill": "payload run src/scripts/backfill-versions.ts",
    "package:cpanel": "node scripts/package-for-cpanel.mjs"
  },
  "dependencies": {
    "@payloadcms/db-sqlite": "^3.88.0",
    "@payloadcms/email-nodemailer": "^3.88.0",
    "@payloadcms/next": "^3.88.0",
    "@payloadcms/richtext-lexical": "^3.88.0",
    "@payloadcms/storage-vercel-blob": "^3.88.0",
    "graphql": "^16.14.2",
    "next": "16.3.4",
    "payload": "^3.88.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "sass": "^1.104.0",
    "typescript": "^5"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  },
  "type": "module"
}
