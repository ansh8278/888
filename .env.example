DATABASE_URI=file:./888.db
PAYLOAD_SECRET=YOUR_SECRET_HERE
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where new-enquiry alerts are sent. Comma-separated for several people.
# Leave blank and leads are still saved, but nobody is emailed.
NOTIFY_EMAIL=dispatch@yourdomain.com

# Email sending. Works with any SMTP provider (Resend, Postmark, SendGrid,
# Fastmail, your host's mailbox). Without these, emails are logged, not sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=dispatch@yourdomain.com
SMTP_FROM_NAME=888 Lock & Key

#Email: admin@888lockandkey.com

# Admin login created by `npm run seed`. Leave the password blank to have one
# generated and printed once at seed time.
SEED_ADMIN_EMAIL=admin@yourdomain.com
SEED_ADMIN_PASSWORD=
